# Rabbit Grill ordering platform - copy to .env and adjust. No secrets are committed.

# --- network -------------------------------------------------------------
# Production: one process serves the app and the API on PORT.
PORT=8344
# Bind address. 0.0.0.0 lets phones on the same Wi-Fi reach the server.
HOST=0.0.0.0
# Development only: the API port behind the Vite dev server (npm run dev).
API_PORT=8345
# The base URL printed inside table QR codes. A phone cannot open "localhost"
# on your laptop - use the laptop's LAN address (e.g. http://192.168.1.20:8344)
# for multi-device testing, and the real https domain only once it is deployed.
PUBLIC_BASE_URL=http://localhost:8344
# Number of reverse proxies in front of the app (0 = direct). Used to read the
# real client IP from X-Forwarded-For for rate limiting.
TRUST_PROXY_HOPS=0
# Set to 1 when served over https so cookies are marked Secure.
COOKIE_SECURE=0

# --- storage -------------------------------------------------------------
DATABASE_PATH=var/rabbit-grill.db
REPORTS_DIR=var/reports

# --- development fixtures --------------------------------------------------
# 1 = on first start, seed the draft catalog, demo tables and demo staff
# accounts (printed to the console). Refused when NODE_ENV=production.
SEED_DEMO=1
# 1 = also seed a synthetic year of fixture orders for the insights screens.
# Fixture rows are flagged and excluded from real reports.
SEED_HISTORY=1

# --- reports ---------------------------------------------------------------
# A Chromium-family browser used to print the annual PDF. Auto-detected on
# Windows (Edge) and common Linux paths when empty.
BROWSER_PATH=

# --- optional online payments (deferred in V1) -----------------------------
# Leave empty: V1 records staff-confirmed offline payments only.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
