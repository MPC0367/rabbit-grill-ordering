# Rabbit Grill ordering platform - copy to .env and adjust. No secrets are committed.
# A variable set in the shell always wins over this file. docs/OPERATIONS.md
# explains every setting; README.md has the quick start.

# --- mode ------------------------------------------------------------------
# Real restaurant installs only: it refuses demo seeding and demo resets.
# Leave it unset for `npm run dev`.
# NODE_ENV=production

# --- network -------------------------------------------------------------
# Production (`npm start`): one process serves the app and the API on PORT.
# Development (`npm run dev`): the browser URL (Vite); the API runs on API_PORT.
PORT=8344
# Bind address. 0.0.0.0 lets phones on the same Wi-Fi reach the server;
# 127.0.0.1 keeps it on this computer only.
HOST=0.0.0.0
# Development only: the API port behind the Vite dev server (default PORT + 1).
# It always listens on 127.0.0.1.
API_PORT=8345
# The base URL printed inside table QR codes. A phone cannot open "localhost"
# on your laptop.
#   unset + npm run dev : http://<this computer's LAN address>:PORT (printed at start)
#   unset + npm start   : http://localhost:PORT, with a warning - set it!
# Use the LAN address (e.g. http://192.168.1.20:8344) for multi-device testing,
# and the real https domain only once that deployment exists. Reprint the QR
# cards whenever this changes.
# PUBLIC_BASE_URL=http://192.168.1.20:8344
# `npm start` only: the number of reverse proxies in front of the app
# (0 = phones connect directly; 1 = one https proxy such as Caddy or nginx).
# The client address for rate limits is then read from X-Forwarded-For. Never
# set it higher than the real number of proxies: clients could then pick their
# own address. The server warns once if X-Forwarded-For arrives while this is 0.
# `npm run dev` does not read this file for it: development always runs with
# 1 (Vite is its one proxy), unless the shell sets a value - a GitHub codespace
# sets 2, for its forwarder plus Vite.
TRUST_PROXY_HOPS=0
# Secure cookies. Leave unset: they then follow PUBLIC_BASE_URL (https:// =
# Secure, http:// = not Secure), which is right for both an https install and
# a plain-http restaurant LAN. Browsers drop Secure cookies over plain http, so
# forcing 1 there stops staff signing in and guests joining. Set 1 only behind
# https, or 0 to switch Secure off; the server warns at start about a mismatch.
# COOKIE_SECURE=

# --- storage -------------------------------------------------------------
# Back up both (npm run jobs -- backup --out <file> --with-reports).
DATABASE_PATH=var/rabbit-grill.db
REPORTS_DIR=var/reports

# --- sessions ------------------------------------------------------------
# STAFF_SESSION_HOURS=14
# GUEST_SESSION_HOURS=12

# --- development fixtures --------------------------------------------------
# Leave these unset. Nothing seeds unless SEED_DEMO=1: not `npm start`, and not
# a bare `node server/main.ts` either.
#   npm run dev   seeds an EMPTY database with the draft catalog, demo tables,
#                 demo staff accounts (demo-<role> / rabbit-<role>-demo) and a
#                 synthetic year of fixture orders, before the server starts.
#                 An interrupted seed is detected and refused: reset and retry.
# SEED_DEMO=0 stops `npm run dev` seeding; SEED_HISTORY=0 skips only the
# synthetic year. Seeding is always refused when NODE_ENV=production.
# SEED_DEMO=
# SEED_HISTORY=

# --- first admin -------------------------------------------------------------
# `npm run admin:create -- --username <name>` asks for the password in the
# terminal. For unattended installs it reads RG_ADMIN_PASSWORD from the shell
# instead; do not store that password in this file.

# --- reports ---------------------------------------------------------------
# A Chromium-family browser used to print the annual PDF. Auto-detected on
# Windows (Edge, Chrome) and common Linux/macOS paths when empty.
BROWSER_PATH=

# --- diagnostics -----------------------------------------------------------
# 1 = log one line per request (never tokens, PINs or passwords).
# LOG_REQUESTS=0
# 0 = the API does not serve dist/ (npm run dev sets this itself).
# SERVE_CLIENT=1
# 1 = also serve dist/assets/*.map. Off: source maps would publish the client source.
# SERVE_SOURCEMAPS=0
# 0 = do not run the daily data-retention task (Settings > Data retention).
# RETENTION_JOB=1

# --- optional online payments (deferred in V1) -----------------------------
# Leave empty: V1 records staff-confirmed offline payments only. No provider
# adapter is wired in, and setting these does not enable online payment.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_SECRET=
